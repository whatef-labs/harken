#!/usr/bin/env php
<?php

/*
 * Artisan for end-to-end runs: a bare Laravel application (Orchestra
 * Testbench) with the providers and environment from tests/E2E/testbench.yaml.
 *
 *   php tests/E2E/artisan harken:start
 */

require __DIR__.'/../../vendor/autoload.php';

$workingPath = dirname(__DIR__, 2);

define('TESTBENCH_CORE', true);
define('TESTBENCH_WORKING_PATH', $workingPath);

$config = Orchestra\Testbench\Foundation\Config::loadFromYaml(
    workingPath: $workingPath,
    filename: __DIR__.DIRECTORY_SEPARATOR.'testbench.yaml',
    defaults: ['providers' => [], 'dont-discover' => []],
);

(new Orchestra\Testbench\Console\Commander($config, $workingPath))->handle();
